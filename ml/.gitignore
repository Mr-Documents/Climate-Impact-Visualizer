.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml

# Run logs are machine-specific and regenerate on every run. The committed
# record of what was measured is reports/training_report.json, not the console
# transcript.
*.log
*.log.*

# Intermediate feature tables are rebuilt by train.py in seconds.
data/processed/*
!data/processed/locations.csv

# data/raw/ IS committed (12 MB of daily parquet). Re-downloading it costs
# ~47,000 weighted API calls - about 4.7 days against the free quota - so
# committing it is what makes the pipeline reproducible by anyone marking it.
#
# models/ IS committed (30 MB). Training cannot run as a deployment build step
# for the same quota reason, so the service needs the artefacts in the repo.
